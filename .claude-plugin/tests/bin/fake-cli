#!/usr/bin/env bash
# Fake CLI for the skill tests: logs its arguments, prints a canned response.
# Usage: fake-cli <tool> [arguments...]   (<tool> is gcloud, gh or git; bin/gcloud,
# bin/gh and bin/git are wrappers). gcloud: log line "$*", response key "$*" with
# spaces as "_". Any other tool: log line "<tool> $*" (plus " <<< <content of the
# --input file, whitespace removed>" when the arguments contain --input <file>),
# response key "<tool>_" + "$*" with spaces and "/" written as "_".
# FAKE_LOG        file that receives one line per call ("$*")
# FAKE_RESPONSES  directory with the scenario's response files
# Response files are matched by name: the arguments with spaces turned into "_"
# must start with the file name minus its extension (projects_list.txt answers
# "projects list ..."); when several names match, the longest wins (ties: first in
# glob order). Fallback: default.txt, else nothing. A file whose name
# ends in .exit1 (projects_list.txt.exit1) prints its content, then exits 1; one
# ending in .exit127 (gh_--version.txt.exit127) prints its content, then exits 127
# (a command that is not installed). .exit127 is not supported on numbered or
# +after+ files.
# Numbered responses: files <prefix>.1.txt, <prefix>.2.txt, ... answer the 1st,
# 2nd, ... call that matches <prefix>; later calls get the last file. The call
# counter lives in a file next to FAKE_LOG.
# State responses: a file <prefix>+after+<marker>.txt answers calls that match
# <prefix> once an earlier call matching <marker> (same "_" rule) is in the log.
# When several apply, the one whose marker call is the most recent wins (on the same
# marker call, the one with the longest prefix); when none applies, the files without
# "+after+" answer as above. They let a read answer by
# what was changed before it, not by how many reads came before.
log="${FAKE_LOG:?FAKE_LOG is not set}"
dir="${FAKE_RESPONSES:-}"
tool="${1:?tool is not set}"; shift
line="$*"
key="$*"
key="${key// /_}"
if [ "$tool" != gcloud ]; then
  key="${tool}_${key//\//_}"
  line="$tool $*"
  prev=""
  for a in "$@"; do
    if [ "$prev" = "--input" ] && [ -f "$a" ]; then
      line="$line <<< $(tr -d '[:space:]' < "$a")"
      break
    fi
    prev="$a"
  done
fi
if [ -d "$dir" ]; then
  best="" ; best_line=0 ; best_len=0
  for f in "$dir"/*+after+*; do
    [ -f "$f" ] || continue
    base="$(basename "$f")"
    name="${base%.exit1}"
    name="${name%.*}"
    prefix="${name%%+after+*}"
    marker="${name#*+after+}"
    case "$key" in "$prefix"*) ;; *) continue ;; esac
    mline=0 ; i=0
    while IFS= read -r logged || [ -n "$logged" ]; do
      i=$(( i + 1 ))
      logged="${logged// /_}"
      case "$logged" in gh_*|git_*) logged="${logged//\//_}" ;; esac
      case "$logged" in "$marker"*) mline=$i ;; esac
    done < <(cat "$log" 2>/dev/null)
    # The most recent marker wins; on the same marker line, the longest prefix wins.
    if [ "$mline" -gt 0 ] && { [ "$mline" -gt "$best_line" ] ||
         { [ "$mline" -eq "$best_line" ] && [ "${#prefix}" -gt "$best_len" ]; }; }; then
      best="$f"; best_line=$mline; best_len=${#prefix}
    fi
  done
  if [ -n "$best" ]; then
    echo "$line" >> "$log"
    cat "$best"
    case "$best" in *.exit1) exit 1 ;; esac
    exit 0
  fi
fi
echo "$line" >> "$log"
[ -d "$dir" ] || exit 0
# The file with the longest matching name wins (so gh_..._example-repo.txt does not
# answer "gh api repos/.../example-repo/rulesets" when a _rulesets file exists);
# on a tie, the first in glob order.
pick="" ; pick_name="" ; pick_num=""
for f in "$dir"/*; do
  [ -f "$f" ] || continue
  base="$(basename "$f")"
  case "$base" in *+after+*) continue ;; esac
  name="${base%.exit1}"
  name="${name%.exit127}"
  name="${name%.*}"
  num=""
  case "$name" in
    *.[0-9]*) num="${name##*.}"; name="${name%.*}" ;;
  esac
  [ "$name" = default ] && continue
  case "$key" in
    "$name"*)
      if [ "${#name}" -gt "${#pick_name}" ]; then pick="$f"; pick_name="$name"; pick_num="$num"; fi
      ;;
  esac
done
if [ -n "$pick" ]; then
  f="$pick"; base="$(basename "$f")"; name="$pick_name"; num="$pick_num"
  if [ -n "$num" ]; then
    # Numbered set: pick the file for this call's ordinal (or the last one).
    counter="$(dirname "$FAKE_LOG")/.count_${name//[^A-Za-z0-9_-]/#}"
    n=$(( $(cat "$counter" 2>/dev/null || echo 0) + 1 ))
    echo "$n" > "$counter"
    chosen="" ; chosen_n=0
    for g in "$dir"/"$name".[0-9]*; do
      [ -f "$g" ] || continue
      gb="$(basename "$g")"
      gn="${gb%.exit1}"; gn="${gn%.txt}"; gn="${gn##*.}"
      if [ "$gn" -le "$n" ] && [ "$gn" -gt "$chosen_n" ]; then chosen="$g"; chosen_n="$gn"; fi
    done
    [ -n "$chosen" ] || chosen="$f"
    f="$chosen"; base="$(basename "$f")"
  fi
  cat "$f"
  case "$base" in *.exit1) exit 1 ;; *.exit127) exit 127 ;; esac
  exit 0
fi
if [ -f "$dir/default.txt" ]; then cat "$dir/default.txt"; fi
if [ -f "$dir/default.txt.exit1" ]; then cat "$dir/default.txt.exit1"; exit 1; fi
exit 0
