{
  "version": 1,
  "cloud": { "provider": "gcp", "region": "us-central1" },
  "domain": "aleogr.dev",
  "repo": { "provider": "github", "visibility": "private", "settings": { "mergeCommit": true, "squash": true, "rebase": false, "deleteBranchOnMerge": true, "issues": true, "wiki": false, "projects": false } },
  "stacks": { "go": { "version": "1.27", "database": { "minVersion": "1.26", "modules": ["cloud.google.com/go/cloudsqlconn@v1.27.1", "github.com/jackc/pgx/v5@v5.13.0"] } } },
  "ci": { "workflowsRepository": "aleogr/aleogr", "deployWorkflow": "deploy-cloud-run.yml" },
  "project": { "services": ["cloudresourcemanager.googleapis.com", "artifactregistry.googleapis.com", "iam.googleapis.com", "iamcredentials.googleapis.com", "sts.googleapis.com", "run.googleapis.com", "iap.googleapis.com"], "registry": { "keep": 5 }, "deploy": { "maxInstances": 2, "cpu": "1", "memory": "512Mi", "placeholderImage": "us-docker.pkg.dev/cloudrun/container/hello:latest" } },
  "platform": {
    "shared": { "project": "shared", "services": ["cloudresourcemanager.googleapis.com", "billingbudgets.googleapis.com", "sqladmin.googleapis.com", "cloudscheduler.googleapis.com", "iam.googleapis.com", "iamcredentials.googleapis.com", "sts.googleapis.com"] },
    "budget": { "displayName": "aleogr", "amount": 100, "currency": "BRL", "thresholds": [0.5, 0.9, 1.0] },
    "database": { "instance": "aleogr-shared", "version": "POSTGRES_18", "edition": "enterprise", "tier": "db-f1-micro", "storageGb": 10, "backupStartUtc": "23:00", "retainedBackups": 7 },
    "switch": { "timeZone": "America/Sao_Paulo", "weeknightStop": "30 22 * * 0-4", "weekendStop": "0 4 * * 6,0", "repository": "aleogr/aleogr" }
  }
}
